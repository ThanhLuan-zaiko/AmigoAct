# AmigoAct frontend configuration.
#
# Copy to `.env` and edit. `.env` is git-ignored; this template is committed.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time.
# Never put a secret in one.

# Base URL of the AmigoAct API.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Dev server port. The Playwright suite overrides this with 3100.
PORT=3000
