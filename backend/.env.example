# AmigoAct API configuration.
#
# Copy to `.env` and edit. `.env` is git-ignored; this template is committed.
# Every setting is optional — the defaults below are what the app uses when the
# variable is absent. All variables are prefixed with AMIGOACT_.

# Shown in the OpenAPI title and returned by /api/health
AMIGOACT_APP_NAME="AmigoAct API"
AMIGOACT_VERSION="0.1.0"

# development | staging | production
AMIGOACT_ENVIRONMENT="development"

# Verbose FastAPI behaviour. Never enable in production.
AMIGOACT_DEBUG=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
AMIGOACT_LOG_LEVEL="INFO"

# Prefix every router is mounted under. /api/health -> <prefix>/health
AMIGOACT_API_PREFIX="/api"

# JSON array of browser origins allowed to call the API.
# Leave empty to disable CORS entirely (the default).
AMIGOACT_CORS_ORIGINS=["http://localhost:3000"]
