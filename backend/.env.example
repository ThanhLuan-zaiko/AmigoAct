# AmigoAct API configuration.
#
# Copy to `.env` and fill in the values. `.env` is git-ignored; this template
# is committed. A key left blank falls back to the built-in default in
# src/backend/config.py. All variables are prefixed with AMIGOACT_.

# Shown in the OpenAPI title and returned by /api/health
AMIGOACT_APP_NAME=
AMIGOACT_VERSION=

# development | staging | production
AMIGOACT_ENVIRONMENT=

# Verbose FastAPI behaviour. Never enable in production.
AMIGOACT_DEBUG=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
AMIGOACT_LOG_LEVEL=

# Prefix every router is mounted under. /api/health -> <prefix>/health
AMIGOACT_API_PREFIX=

# JSON array of browser origins allowed to call the API, e.g.
# ["http://localhost:3000"]. Leave empty to disable CORS entirely.
AMIGOACT_CORS_ORIGINS=

# --------------------------------------------------------------------------
# Oracle Database — gvenzl/oracle-free running in Docker on WSL.
#
# Thin-mode driver, Easy Connect string: AMIGOACT_DB_HOST:AMIGOACT_DB_PORT/AMIGOACT_DB_SERVICE
# The container publishes 1521 on the WSL host, and WSL forwards localhost
# ports to Windows, so AMIGOACT_DB_HOST=localhost reaches it from Windows.
# ORACLE_DATABASE in `docker run` becomes the PDB -> AMIGOACT_DB_SERVICE.
# --------------------------------------------------------------------------

# Set to false to boot the app without a database (tests do this).
AMIGOACT_DB_ENABLED=
AMIGOACT_DB_HOST=
AMIGOACT_DB_PORT=
AMIGOACT_DB_SERVICE=

# Application schema the API connects as. Created by reset_database.ps1.
AMIGOACT_DB_USER=
AMIGOACT_DB_PASSWORD=

# Pool sizing.
AMIGOACT_DB_POOL_MIN=
AMIGOACT_DB_POOL_MAX=
AMIGOACT_DB_POOL_INCREMENT=

# Admin username used ONLY by reset_database.ps1 to drop and recreate
# AMIGOACT_DB_USER — SYSTEM here, or SYS to connect AS SYSDBA. The admin
# password is intentionally NOT a .env key: the script reads
# AMIGOACT_DB_ADMIN_PASSWORD from the real environment or prompts for it
# interactively, so it is never stored in a file.
AMIGOACT_DB_ADMIN_USER=
